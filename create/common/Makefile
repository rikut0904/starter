.PHONY: help up down logs test lint build format
help:
	@echo "利用可能: up down logs test lint build format"
up:
	@echo "プロファイルに応じて開発サーバーを起動してください"
down:
	docker compose down
logs:
	docker compose logs -f
test:
	@echo "テストを実行してください"
lint:
	@echo "Lintを実行してください"
build:
	@echo "ビルドを実行してください"
format:
	@echo "フォーマットを実行してください"
